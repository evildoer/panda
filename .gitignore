# Секреты и личное -- НЕ коммитить!
config.json
# копии и временные варианты боевого конфига (v2.79: после чистки рядом остаётся
# config.json.bak) -- в них ТЕ ЖЕ токен и ключ базы, поэтому правило то же
config.json.*
*.sqlite
*.sqlite-journal
logs/
# заявка на интенты и шпаргалка к ней: там id и цифры реального сервера,
# публиковать не нужно
intents-request.md
intents-cheatsheet.md

# Политика конфиденциальности -- ЛИЧНЫЙ документ конкретного бота: в ней ник
# владельца, названия его серверов, сроки хранения из ЕГО config.json и значок его
# ключа. В чужом репозитории этому не место: кто ставит бота себе -- генерирует
# свою командой `node . privacy` из privacy.template.md (шаблон в репозитории есть,
# а готовый PRIVACY.md -- нет). Владелец выкладывает его по своему адресу
# (privacy_url) -- например в gist.
PRIVACY.md

# Пояснения к коду: весь текст, который раньше лежал в index.js комментариями, плюс
# подробности по каждой партии изменений. Это ЛИЧНЫЙ рабочий файл: в README (его владелец
# показывает людям) идёт только короткий список вех, а простыни -- здесь. В репозиторий
# не попадает. Вернуть комментарии в код: cp logs/index-before-strip.js.bak index.js
# И копии рядом: имя вида README.local.md.before-... правило выше НЕ закрывало
# (такое же было с config.json -- проверено на живом случае), а внутри тот же личный текст.
README.local.md
README.local.md.*

# Зависимости и рантайм
node_modules/
node-v*/

# Файл cookie для yt-dlp (MUSIC.cookies_file): это доступ к аккаунту, в репозитории
# ему не место. Частые имена -- cookies.txt (экспорт расширений) и cookie-firefox-incognito.txt.
# [v2.147] Правило ОДНО и универсальное: любое имя на "cookie" (и "cookies" -- звёздочка
# поглощает "s") закрыто строкой ниже. Прежнее отдельное firefox.txt убрано: файл с таким
# именем эта строка НЕ закрывает, поэтому называй файлы cookie*.txt -- так же пишет и сама
# команда `node . cookies --save` (в MUSIC.cookies_file или cookies.txt).
cookie*.txt

# Кэш аудио (MUSIC.cache): это просто скачанные треки, их не коммитим и не жалеем --
# папка удаляется в любой момент, бот скачает заново. Если кэш уведён в другое место
# (MUSIC.cache_dir) -- ничего страшного, папка создастся сама.
music_cache/

# Локальные удобства владельца: окно-консоль и ярлык запуска.
# К боту не относятся, у каждого свои.
console.bat
PANDAMIA.lnk

# Журнал перешифровки базы (команда /rekey): появляется только пока перешифровка не доведена
# до конца и удаляется сам. Ключей внутри нет, но это рабочая мелочь, а не часть проекта.
db_rekey.journal

# Мусор систем и редакторов
Thumbs.db
Desktop.ini
~$*
*.log
*.tmp
_*


# Инструмент обхода DPI (tools/zapret-pick.ps1): сам скрипт -- в репозитории, а всё,
# что он создаёт при работе, -- нет. Там скачанный движок zapret (чужие бинарники и
# драйвер WinDivert -- в git им не место), его лог, готовый запуск и сторож.
tools/zapret-work/

# Freebuff служебное
.freebuff/
